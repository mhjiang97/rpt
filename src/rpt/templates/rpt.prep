{{def(patient_name, sex, birth_date, tumor_type, specimen_site, collection_date, report_date, known_rearrangement, sv_burden, rearrangement_description, therapies)}}
<!DOCTYPE document SYSTEM "rml.dtd">
<document filename="rpt.pdf">
    <docinit>
        <color id="primary" CMYK="[0.94,0.38,0.0,0.55]" RGB="#0b4f6c" />
        <color id="accent" RGB="#e8833a" />
        <color id="ink" RGB="#1f2a30" />
        <color id="muted" RGB="#6b7280" />
        <color id="rule" RGB="#dde3e7" />
        <color id="tint" RGB="#eef4f6" />
    </docinit>
    <template title="Structural Variant Report" author="Minghao Jiang" pageSize="595,842"
        leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36">
        <pageTemplate id="first">
            <pageGraphics>
                <!-- Header band -->
                <fill color="primary" />
                <rect x="0" y="790" width="595" height="52" fill="yes" stroke="no" />
                <fill color="accent" />
                <rect x="0" y="787" width="595" height="3" fill="yes" stroke="no" />
                <fill color="white" />
                <setFont name="Helvetica-Bold" size="14" />
                <drawString x="36" y="815">Structural Variant Report</drawString>
                <setFont name="Helvetica" size="8.5" />
                <drawString x="36" y="800">Long-read whole genome sequencing</drawString>
                <setFont name="Helvetica-Bold" size="10" />
                <drawRightString x="559" y="815">{{patient_name}}</drawRightString>
                <setFont name="Helvetica" size="8.5" />
                <drawRightString x="559" y="800">Report date {{report_date}}</drawRightString>
                <!-- Footer -->
                <stroke color="rule" />
                <lineMode width="0.5" />
                <lines>36 44 559 44</lines>
                <fill color="muted" />
                <setFont name="Helvetica" size="7.5" />
                <drawString x="36" y="32">Patient {{patient_name}}  |  {{tumor_type}}</drawString>
                <drawRightString x="559" y="32">Page <pageNumber /> of <getName id="lastPage" default="0" /></drawRightString>
            </pageGraphics>
            <frame id="summary" x1="36" y1="525" width="523" height="246" />
            <frame id="first_left" x1="36" y1="56" width="250.5" height="457" />
            <frame id="first_right" x1="308.5" y1="56" width="250.5" height="457" />
        </pageTemplate>
        <pageTemplate id="later">
            <pageGraphics>
                <fill color="primary" />
                <rect x="0" y="806" width="595" height="36" fill="yes" stroke="no" />
                <fill color="accent" />
                <rect x="0" y="803" width="595" height="3" fill="yes" stroke="no" />
                <fill color="white" />
                <setFont name="Helvetica-Bold" size="10" />
                <drawString x="36" y="820">Structural Variant Report</drawString>
                <setFont name="Helvetica" size="8.5" />
                <drawRightString x="559" y="820">{{patient_name}}  |  {{report_date}}</drawRightString>
                <stroke color="rule" />
                <lineMode width="0.5" />
                <lines>36 44 559 44</lines>
                <fill color="muted" />
                <setFont name="Helvetica" size="7.5" />
                <drawString x="36" y="32">Patient {{patient_name}}  |  {{tumor_type}}</drawString>
                <drawRightString x="559" y="32">Page <pageNumber /> of <getName id="lastPage" default="0" /></drawRightString>
            </pageGraphics>
            <frame id="left" x1="36" y1="56" width="250.5" height="731" />
            <frame id="right" x1="308.5" y1="56" width="250.5" height="731" />
        </pageTemplate>
    </template>
    <stylesheet>
        <paraStyle name="body" fontName="Helvetica" fontSize="9" leading="13.5"
            textColor="ink" spaceAfter="6" />
        <paraStyle name="cell" fontName="Helvetica" fontSize="9" leading="11" textColor="ink" />
        <paraStyle name="h1" fontName="Helvetica-Bold" fontSize="11.5" leading="14"
            textColor="primary" spaceBefore="10" textTransform="uppercase" keepWithNext="1" />
        <paraStyle name="h2" fontName="Helvetica-Bold" fontSize="9.5" leading="13"
            textColor="ink" spaceBefore="6" spaceAfter="3" keepWithNext="1" />
        <paraStyle name="label" fontName="Helvetica-Bold" fontSize="7.5" leading="10"
            textColor="muted" textTransform="uppercase" spaceAfter="4" />
        <paraStyle name="value" fontName="Helvetica-Bold" fontSize="17" leading="21"
            textColor="primary" />
        <paraStyle name="value_none" parent="value" textColor="muted" />
        <paraStyle name="note" fontName="Helvetica" fontSize="7.5" leading="10"
            textColor="muted" spaceBefore="4" />
        <blockTableStyle id="patient">
            <blockFont name="Helvetica-Bold" size="8" start="0,0" stop="-1,0" />
            <blockTextColor colorName="primary" start="0,0" stop="-1,0" />
            <blockFont name="Helvetica" size="8" start="0,1" stop="0,-1" />
            <blockFont name="Helvetica" size="8" start="2,1" stop="2,-1" />
            <blockTextColor colorName="muted" start="0,1" stop="0,-1" />
            <blockTextColor colorName="muted" start="2,1" stop="2,-1" />
            <blockSpan start="0,0" stop="1,0" />
            <blockSpan start="2,0" stop="3,0" />
            <blockValign value="MIDDLE" />
            <blockLeftPadding length="0" />
            <blockTopPadding length="5" />
            <blockBottomPadding length="5" />
            <lineStyle kind="LINEBELOW" colorName="primary" thickness="1.2" start="0,0" stop="1,0" />
            <lineStyle kind="LINEBELOW" colorName="primary" thickness="1.2" start="2,0" stop="3,0" />
            <lineStyle kind="LINEBELOW" colorName="rule" thickness="0.5" start="0,1" stop="1,-1" />
            <lineStyle kind="LINEBELOW" colorName="rule" thickness="0.5" start="2,1" stop="3,-1" />
        </blockTableStyle>
        <blockTableStyle id="cards">
            <blockValign value="TOP" />
            <blockBackground colorName="tint" start="0,0" stop="0,0" />
            <blockBackground colorName="tint" start="2,0" stop="2,0" />
            <lineStyle kind="LINEBEFORE" colorName="accent" thickness="3" start="0,0" stop="0,0" />
            <lineStyle kind="LINEBEFORE" colorName="primary" thickness="3" start="2,0" stop="2,0" />
            <blockLeftPadding length="12" />
            <blockRightPadding length="12" />
            <blockTopPadding length="10" />
            <blockBottomPadding length="12" />
        </blockTableStyle>
        <blockTableStyle id="cards_none">
            <blockValign value="TOP" />
            <blockBackground colorName="tint" start="0,0" stop="0,0" />
            <blockBackground colorName="tint" start="2,0" stop="2,0" />
            <lineStyle kind="LINEBEFORE" colorName="muted" thickness="3" start="0,0" stop="0,0" />
            <lineStyle kind="LINEBEFORE" colorName="primary" thickness="3" start="2,0" stop="2,0" />
            <blockLeftPadding length="12" />
            <blockRightPadding length="12" />
            <blockTopPadding length="10" />
            <blockBottomPadding length="12" />
        </blockTableStyle>
    </stylesheet>
    <story>
        <setNextTemplate name="later" />
        <blockTable style="patient" colWidths="92,165.5,92,173.5">
            <tr>
                <td>PATIENT</td><td></td>
                <td>SPECIMEN</td><td></td>
            </tr>
            <tr>
                <td>Name</td><td><para style="cell">{{patient_name}}</para></td>
                <td>Specimen site</td><td><para style="cell">{{specimen_site}}</para></td>
            </tr>
            <tr>
                <td>Date of birth</td><td><para style="cell">{{birth_date}}</para></td>
                <td>Collection date</td><td><para style="cell">{{collection_date}}</para></td>
            </tr>
            <tr>
                <td>Sex</td><td><para style="cell">{{sex}}</para></td>
                <td>Report date</td><td><para style="cell">{{report_date}}</para></td>
            </tr>
            <tr>
                <td>Diagnosis</td><td><para style="cell">{{tumor_type}}</para></td>
                <td>Assay</td><td><para style="cell">Long-read WGS</para></td>
            </tr>
        </blockTable>
        <spacer length="22" />
        <para style="h1" spaceBefore="0">Results summary</para>
        <hr width="100%" thickness="1.2" color="primary" spaceBefore="3" spaceAfter="10" />
        <blockTable style="{{"cards" if known_rearrangement else "cards_none"}}" colWidths="254,15,254">
            <tr>
                <td>
                    <para style="label">Known gene rearrangement</para>
                    {{if known_rearrangement}}
                    <para style="value"><i>{{known_rearrangement}}</i></para>
                    <para style="note">See Genomic findings for interpretation.</para>
                    {{else}}
                    <para style="value_none">None detected</para>
                    <para style="note">No rearrangement from the curated list was found.</para>
                    {{endif}}
                </td>
                <td></td>
                <td>
                    <para style="label">Tumor structural variant burden</para>
                    <para style="value">{{sv_burden}} <font size="10" color="muted">variants/Mb</font></para>
                    <para style="note">Merged SV calls across the genome, per megabase.</para>
                </td>
            </tr>
        </blockTable>
        <nextFrame name="first_left" />
        <para style="h1" spaceBefore="0">Biomarker findings</para>
        <hr width="100%" thickness="1.2" color="primary" spaceBefore="3" spaceAfter="6" />
        <para style="h2">Tumor structural variant burden</para>
        <para style="body">
            Tumor Structural Variant Burden refers to the total number or extent of structural variants present within the genome of a tumor. Structural variants are significant alterations in the DNA sequence, including deletions, duplications, inversions, translocations, and insertions. These changes can profoundly affect gene function and are often key drivers in the development and progression of cancer.
        </para>
        <para style="body">
            Structural variant burden provides a measure of the cumulative impact of these genomic alterations within a tumor. A high SV burden is commonly associated with genomic instability, a hallmark of many cancers. This instability can lead to increased tumor heterogeneity, influencing the tumor's behavior, including its potential for aggressiveness, metastasis, and response to therapy.
        </para>
        <para style="body">
            Understanding the structural variant burden is critical for tailoring cancer treatments. Tumors with a high SV burden may exhibit different responses to therapies, such as immunotherapy or treatments targeting DNA repair pathways. For instance, tumors with defects in DNA repair mechanisms, such as those involving BRCA1/BRCA2, often have elevated SV burdens and may respond to PARP inhibitors or other targeted therapies. Therefore, assessing the SV burden not only provides insights into the biology of the tumor but also supports more personalized and effective treatment strategies.
        </para>
        <condPageBreak height="90" />
        <para style="h1">Genomic findings</para>
        <hr width="100%" thickness="1.2" color="primary" spaceBefore="3" spaceAfter="6" />
        <para style="h2">Known gene rearrangements</para>
        <para style="body">
            Gene rearrangements, a specific type of structural variant, are particularly well-studied in leukemia and play a critical role in its pathogenesis. These rearrangements often result from chromosomal translocations, where segments of DNA are exchanged between non-homologous chromosomes, leading to the formation of fusion genes. These fusion genes can drive uncontrolled cell growth and survival, contributing to leukemia development.
        </para>
        <para style="body">
            The identification of gene rearrangements in leukemia has revolutionized diagnosis, risk stratification, and treatment. Many of these rearrangements serve as diagnostic markers, allowing for precise classification of leukemia subtypes. Additionally, they are critical therapeutic targets. For example, the discovery of the BCR-ABL1 fusion gene led to the development of TKIs, which have dramatically improved survival rates in CML.
        </para>
        <para style="body">
            Assessing structural variants, including gene rearrangements, is now a standard part of leukemia workups using sequencing and other molecular techniques. These findings not only inform prognosis but also guide personalized treatment strategies, ensuring that patients receive the most effective therapies for their specific genetic alterations.
        </para>
        <condPageBreak height="90" />
        {{if known_rearrangement}}
        <para style="h2"><i>{{known_rearrangement}}</i></para>
        {{else}}
        <para style="h2">Result for this sample</para>
        {{endif}}
        {{if not known_rearrangement}}
        <para style="body">
            No known gene rearrangement was detected in this sample.
        </para>
        {{elif not rearrangement_description}}
        <para style="body">
            No description is available for this rearrangement.
        </para>
        {{endif}}
        {{for paragraph in rearrangement_description}}
        <para style="body">
            {{paragraph}}
        </para>
        {{endfor}}
        {{if therapies}}
        <condPageBreak height="90" />
        <para style="h1">Therapies</para>
        <hr width="100%" thickness="1.2" color="primary" spaceBefore="3" spaceAfter="6" />
        <para style="body" textColor="muted">
            Therapies relevant to the detected rearrangement.
        </para>
        {{for therapy in therapies}}
        <para style="h2">{{therapy["name"]}}</para>
        <para style="body">
            {{therapy["text"]}}
        </para>
        {{endfor}}
        {{endif}}
        <namedString id="lastPage"><pageNumber /></namedString>
    </story>
</document>
